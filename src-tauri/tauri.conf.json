{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garia",
  "version": "0.1.0",
  "identifier": "com.fabimc.garia",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run sidecar",
    "beforeBuildCommand": "npm run sidecar -- universal-apple-darwin"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Garia",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["garia", "magnet"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyODE4QTkzNzY5RjNGRUUKUldUdVA1OTJrNHFCZ2tnd3cxeWEvbENZcmN5OXI1WDdUbzZXUnpXMTRWUk14SUErL1R3b3NaVXAK",
      "endpoints": [
        "https://github.com/fabimc/garia/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/aria2c", "binaries/ffmpeg"],
    "resources": ["resources/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent Document",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent",
        "rank": "Default"
      }
    ],
    "category": "Utility",
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    }
  }
}
