{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "garia",
  "version": "0.1.0",
  "identifier": "com.fabimc.garia",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run sidecar",
    "beforeBuildCommand": "npm run sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "garia",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["garia"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aria2c", "binaries/ffmpeg"],
    "resources": ["resources/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
