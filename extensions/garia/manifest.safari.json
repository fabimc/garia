{
  "manifest_version": 3,
  "name": "Garia",
  "version": "0.1.0",
  "description": "Send file downloads and video pages to Garia.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Send this page to Garia",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "scripts": ["file-types.js", "background.js"],
    "persistent": false
  },
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["file-types.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.0"
    }
  }
}
