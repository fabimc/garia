{
  "manifest_version": 3,
  "name": "Garia",
  "short_name": "Garia",
  "version": "0.1.0",
  "description": "Send file downloads and video pages to the Garia desktop app.",
  "homepage_url": "https://github.com/fabimc/garia",
  "author": "fabimc",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Send this page to Garia",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["file-types.js", "background.js"]
  },
  "permissions": ["clipboardWrite", "contextMenus", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["file-types.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["file-types.js", "video-button.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "garia@fabimc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "safari": {
      "strict_min_version": "16.0"
    }
  }
}
